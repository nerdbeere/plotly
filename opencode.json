{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "mcp": {
    "looper-plugins": {
      "command": [
        "/Users/hol0008j/Projects/private/looper/target/debug/looper",
        "mcp-plugins",
        "--task-id",
        "gardenplot-pr-reviewer-release",
        "--tasks-dir",
        "/Users/hol0008j/.config/looper/tasks",
        "--logs-dir",
        "/Users/hol0008j/.config/looper/logs",
        "--plugins-file",
        "/Users/hol0008j/.config/looper/plugins.json"
      ],
      "enabled": true,
      "type": "local"
    },
    "task-memory": {
      "command": [
        "/Users/hol0008j/Projects/private/looper/target/debug/looper",
        "mcp-memory",
        "--task-id",
        "gardenplot-pr-reviewer-release",
        "--storage-dir",
        "/Users/hol0008j/.config/looper/memory",
        "--max-bytes",
        "5242880"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "gh *": "allow",
      "git *": "allow",
      "node *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "rsync *192.168.1.12*": "allow",
      "rtk *": "allow",
      "scp *192.168.1.12*": "allow",
      "ssh *192.168.1.12*": "allow",
      "ssh -i /Users/hol0008j/.ssh/plotly*": "allow"
    },
    "external_directory": {
      "/Users/hol0008j/.ssh/**": "ask",
      "/Users/hol0008j/.ssh/plotly": "allow",
      "/Users/hol0008j/.ssh/plotly.pub": "allow"
    },
    "read": {
      "*": "allow",
      "/Users/hol0008j/.ssh/plotly": "allow",
      "/Users/hol0008j/.ssh/plotly.pub": "allow"
    }
  }
}